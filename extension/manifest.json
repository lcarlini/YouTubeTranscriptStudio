{
  "manifest_version": 3,
  "name": "YouTube Transcript Studio",
  "version": "1.0.0",
  "description": "Extract the current YouTube transcript, export it, and chat with a local in-browser AI.",
  "key": "",
  "permissions": ["sidePanel", "storage", "tabs", "scripting"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtu.be/*",
    "https://huggingface.co/*",
    "https://*.huggingface.co/*",
    "https://hf.co/*",
    "https://*.hf.co/*",
    "https://cdn.jsdelivr.net/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Transcript Studio",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "dist/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "externally_connectable": {
    "matches": [
      "https://lcarlini.github.io/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}
