{
  "name": "youtube-transcript-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": ["shared", "docs", "extension"],
  "scripts": {
    "dev": "npm run dev -w @yts/docs",
    "build": "npm run build -w @yts/docs && npm run build -w @yts/extension",
    "typecheck": "tsc -p shared --noEmit && tsc -p docs --noEmit && tsc -p extension --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "preview": "npm run preview -w @yts/docs"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/chrome": "^0.1.4",
    "@types/node": "^24.5.2",
    "esbuild": "^0.25.10",
    "eslint": "^9.36.0",
    "fake-indexeddb": "^6.2.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
